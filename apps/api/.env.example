# ---- Server ----
PORT=4000
# โดเมนของเว็บที่อนุญาตให้เรียก API (คั่นด้วยเครื่องหมายจุลภาค)
WEB_ORIGIN=http://localhost:3000

# ---- PostgreSQL ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cyberjob?schema=public"

# ---- JWT ----
# เปลี่ยนเป็นค่าสุ่มยาว ๆ ก่อนขึ้น production เช่น `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# เมื่อ Frontend และ Backend อยู่คนละโดเมน HTTPS
# Frontend/Backend บน Hostinger เป็นคนละโดเมน HTTPS จึงต้องใช้สองค่านี้
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# ---- Google OAuth 2.0 ----
# สร้าง OAuth client ที่ https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# หน้าเว็บที่จะพากลับไปหลัง login สำเร็จ
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
