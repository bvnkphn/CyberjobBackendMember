// CyberJob – PostgreSQL schema
// สร้าง client:   npm run prisma:generate -w @cyberjob/api
// สร้าง migration: npm run prisma:migrate -w @cyberjob/api

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Enum
// ------------------------------------------------------------------

/// รูปแบบการทำงาน
enum WorkStyle {
  ONSITE
  HYBRID
  REMOTE
}

/// ประเภทงาน
enum EmploymentType {
  FULLTIME
  PARTTIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

/// ประสบการณ์ทำงาน
enum ExperienceLevel {
  NONE // 0 ปี
  ONE_TWO // 1-2 ปี
  THREE_FIVE // 3-5 ปี
  SIX_TEN // 6-10 ปี
  TEN_PLUS // 10 ปีขึ้นไป
}

/// ช่องทางที่ผู้ใช้สมัครเข้ามา
enum AuthProvider {
  LOCAL
  GOOGLE
}

/// แหล่งที่มาของผู้สมัคร – ใช้ในหลังบ้าน Admin (Feature 3)
enum CandidateSource {
  CYBERPAY_INTERN
  OUTSIDER
}

enum UserRole {
  JOBSEEKER
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEW
  REJECTED
  HIRED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

/// รูปแบบองค์กร (Owner Feature 3.1)
enum CompanyType {
  PRIVATE
  GOVERNMENT
  STATE_ENTERPRISE
}

/// สถานะการยืนยันบริษัทจากหน้า Gate ของผู้ประกอบการ (Owner Feature 8)
enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

/// สถานะประกาศงานฝั่งผู้ประกอบการ – isActive ยังเป็นตัวตัดสินว่าหน้าเว็บเห็นหรือไม่
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// ประเภทคำตอบของคำถามคัดกรอง (Owner Feature 4.2.1)
enum QuestionType {
  SINGLE
  DATE
  SHORT
  MULTI
  LONG
}

enum InvitationStatus {
  SENT
  ACCEPTED
  DECLINED
}

/// แพ็กเกจของบริษัท (Owner Feature 9)
enum PackagePlan {
  FREE
  GOLD
  PLATINUM
}

/// ตารางคำนิยามแพ็กเกจที่ Admin กำหนดได้ (Admin Feature - Package Management)
model PackageTierDefinition {
  id              String   @id @default(cuid())
  plan            PackagePlan @unique
  name            String
  price           Int      // บาทต่อรอบบิล
  billingCycle    String   // "forever" | "month" | "year"
  quotaJobs       Int      // จำนวนประกาศงานที่โพสต์ได้
  highlightJobs   Int      // จำนวนประกาศงาน Hot Job
  candidateViews  Int      // จำนวนการดูโปรไฟล์ผู้สมัคร
  aiMatching      Boolean  @default(false)
  inviteCandidates Boolean @default(false)
  dedicatedSupport Boolean @default(false)
  popular         Boolean  @default(false)
  sortOrder       Int      @default(0)
  features        String[] @default([]) // รายการ Feature ที่แสดงบน UI
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// การตั้งค่าระบบโดยรวม (Admin Feature - System Settings)
model SystemSetting {
  id                     String   @id @default("default")
  maintenanceMode        Boolean  @default(false)
  announcementTitle      String   @default("ระบบปิดปรับปรุงชั่วคราวเพื่ออัปเกรดความปลอดภัย")
  announcementMsg        String   @default("ทีมงาน Cyber Job กำลังดำเนินการปรับปรุงระบบโครงสร้างพื้นฐานเพื่อเพิ่มประสิทธิภาพและความปลอดภัย ขออภัยในความไม่สะดวก ระบบจะกลับมาใช้งานได้ตามปกติในเร็ว ๆ นี้")
  estimatedDowntime      String   @default("2 ชั่วโมง")
  maintenanceStart       String?
  maintenanceEnd         String?
  newOrderAlert          Boolean  @default(true)
  failedTransactionAlert Boolean  @default(true)
  lowApiAlert            Boolean  @default(true)
  dailyReportEmail       Boolean  @default(true)
  alertRecipients        String   @default("admin@cyberjob.asia, support@cyberjob.asia")
  dailyReportTime        String   @default("00:00")
  platformName           String   @default("CyberJob Asia")
  supportEmail           String   @default("support@cyberjob.asia")
  supportPhone           String   @default("02-123-4567")
  registrationEnabled    Boolean  @default(true)
  jobPostingEnabled      Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  updatedBy              String?
}

/// พจนานุกรมคำพ้องและทักษะที่เกี่ยวข้อง (Admin Feature - Synonym & Keyword Dictionary)
model SynonymGroup {
  id              String   @id @default(cuid())
  name            String   @unique // Main Keyword
  category        String   @default("General")
  synonyms        String[] @default([])
  autoAiGenerated Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

enum PaymentMethod {
  PROMPTPAY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------------------------------
// บริษัทและประกาศงาน
// ------------------------------------------------------------------

model Company {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  legalName     String
  logoText      String
  logoColor     String
  verified      Boolean @default(false)
  businessType  String
  employeeCount String?
  about         String

  // ข้อมูลติดต่อ
  email   String
  phone   String
  website String
  address String

  province String
  district String?

  coverImage String?
  gallery    String[] @default([])
  lat        Float?
  lng        Float?

  /// บัญชีผู้ประกอบการที่ดูแลบริษัทนี้ – บริษัทตัวอย่างจาก seed ไม่มีเจ้าของ
  ownerId            String?            @unique
  owner              User?              @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  companyType        CompanyType        @default(PRIVATE)
  registrationNumber String?
  contactName        String?
  contactPosition    String?
  contactPhone       String?
  logoUrl            String?
  mapUrl             String?
  /// false = ซ่อนหน้าบริษัทจากการค้นหาบนเว็บ (ตั้งค่าความเป็นส่วนตัว)
  isPublic           Boolean            @default(true)
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  verificationSubmittedAt DateTime?
  /// เอกสารยืนยันบริษัท { certificate: [{ name, path, size, mimeType }], directorId, workplace, vat }
  documents          Json               @default("{}")
  plan               PackagePlan        @default(FREE)
  planExpiresAt      DateTime?

  jobs               Job[]
  candidateBookmarks CandidateBookmark[]
  invitations        Invitation[]
  payments           SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province])
}

model Job {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  category    String
  subcategory String?
  province    String
  district    String?

  workStyle       WorkStyle
  employmentType  EmploymentType
  experienceLevel ExperienceLevel

  salaryMin        Int
  salaryMax        Int
  salaryNegotiable Boolean @default(false)

  postedAt DateTime
  isUrgent Boolean  @default(false)
  isActive Boolean  @default(true)
  /// ลบโดยผู้ดูแลระบบ – เก็บแถวไว้เพื่อไม่ให้ประวัติการสมัครและบุ๊กมาร์กหายตาม
  deletedAt DateTime?

  summary     String
  description String

  requirements             String[] @default([])
  additionalQualifications String[] @default([])
  employerAnswers          String[] @default([])
  benefits                 String[] @default([])
  skills                   String[] @default([])

  openings   Int     @default(1)
  coverImage String?

  /// สถานะที่ผู้ประกอบการเห็น – ร่าง/เผยแพร่/ปิดรับสมัคร
  status          JobStatus @default(PUBLISHED)
  department      String?
  /// จำนวนปีประสบการณ์ที่ต้องการแบบตัวเลข (experienceLevel เป็นช่วงสำหรับตัวกรองหน้าเว็บ)
  experienceYears Int?

  bookmarks    Bookmark[]
  applications Application[]
  questions    JobQuestion[]
  invitations  Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([category])
  @@index([province])
  @@index([postedAt])
  @@index([salaryMin, salaryMax])
}

// ------------------------------------------------------------------
// ผู้ใช้และการยืนยันตัวตน
// ------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  /// รหัสที่คนอ่านได้ เช่น CJ-0008 – ฐานข้อมูลออกให้เองจาก sequence
  code         String       @unique @default(dbgenerated("next_user_code()"))
  email        String       @unique
  /// เป็น null เมื่อสมัครผ่าน OAuth
  passwordHash String?
  name         String
  avatarUrl    String?
  provider     AuthProvider @default(LOCAL)
  /// id ของผู้ใช้ที่ฝั่ง OAuth provider
  providerId   String?
  role         UserRole     @default(JOBSEEKER)
  candidateSource CandidateSource @default(OUTSIDER)
  gateCompleted Boolean     @default(false)
  gateSkipped   Boolean     @default(false)
  gateCompletedAt DateTime?

  bookmarks     Bookmark[]
  applications  Application[]
  refreshTokens RefreshToken[]
  profile       CandidateProfile?

  ownedCompany       Company?            @relation("CompanyOwner")
  bookmarkedByCompanies CandidateBookmark[]
  invitations        Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
}

model CandidateProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName            String?
  lastName             String?
  address              String?
  desiredJobCategories String[] @default([])
  privacy              String   @default("private")
  sections             Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// เก็บเฉพาะ hash ของ refresh token เพื่อให้เพิกถอนได้
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ------------------------------------------------------------------
// งานที่บันทึกไว้ และการสมัครงาน
// ------------------------------------------------------------------

/// Feature 7.1 – ผู้สมัครบันทึกไว้ได้ว่าสนใจงานไหน
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SUBMITTED)
  coverLetter String?
  answers     ApplicationAnswer[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

/// คำถามคัดกรองที่ผู้ประกอบการตั้งไว้ในประกาศงาน (Owner Feature 4.2.1)
model JobQuestion {
  id       String       @id @default(cuid())
  jobId    String
  job      Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  position Int
  type     QuestionType
  text     String
  options  String[]     @default([])
  required Boolean      @default(true)
  answers  ApplicationAnswer[]

  @@index([jobId])
}

/// คำตอบของผู้สมัคร – เก็บข้อความคำถามไว้ด้วย เผื่อผู้ประกอบการแก้คำถามภายหลัง
model ApplicationAnswer {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String?
  question      JobQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  questionText  String
  questionType  QuestionType
  /// string สำหรับคำตอบเดียว หรือ string[] สำหรับเลือกหลายข้อ
  answer        Json
  position      Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([applicationId])
}

/// ผู้ประกอบการบันทึกผู้สมัครที่สนใจ (Owner Feature 2.3) – คนละตารางกับ Bookmark งานของผู้หางาน
model CandidateBookmark {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([companyId, candidateId])
  @@index([companyId])
}

/// คำเชิญให้ผู้หางานมาสมัครงาน (Owner Feature 2.5)
model Invitation {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  message     String?
  status      InvitationStatus @default(SENT)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([companyId, candidateId, jobId])
  @@index([companyId])
  @@index([candidateId])
}

/// หลักฐานการชำระค่าแพ็กเกจ (Owner Feature 9) – ผู้ดูแลระบบเป็นคนอนุมัติ
model SubscriptionPayment {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan       PackagePlan
  /// บาท
  amount     Int
  method     PaymentMethod
  proofPath  String
  proofName  String
  status     PaymentStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([companyId])
}

// ------------------------------------------------------------------
// Contact Support (Feature 3.4)
// ------------------------------------------------------------------

model SupportTicket {
  id        String       @id @default(cuid())
  ref       String       @unique
  name      String
  email     String
  topic     String
  message   String
  /// ผู้แจ้งที่ล็อกอินอยู่ (ถ้ามี) และรูปประกอบที่แนบมา
  userId      String?
  attachments String[]     @default([])
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
}

// ------------------------------------------------------------------
// รหัส OTP สำหรับเข้าสู่ระบบ / ยืนยันตัวตน (2FA)
// ------------------------------------------------------------------

model OtpCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  type      String    @default("LOGIN_2FA")
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email, type])
  @@index([expiresAt])
}

