{
  "name": "cyberjob-backend",
  "private": true,
  "version": "0.1.0",
  "description": "CyberJob \u2013 backend (NestJS + Prisma + PostgreSQL)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @cyberjob/shared",
    "prisma:generate": "npm run prisma:generate -w @cyberjob/api",
    "setup": "npm install && npm run build:shared && npm run prisma:generate",
    "dev": "npm run build:shared && npm run start:dev -w @cyberjob/api",
    "build": "npm run build:shared && npm run build -w @cyberjob/api",
    "start": "npm run start:prod -w @cyberjob/api",
    "db:migrate": "npm run prisma:migrate -w @cyberjob/api",
    "db:seed": "npm run db:seed -w @cyberjob/api",
    "db:reset": "npm run db:reset -w @cyberjob/api",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "npm run build:shared && npm run prisma:generate && tsc -p apps/api/tsconfig.json --noEmit",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
