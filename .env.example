# ใช้กับ docker compose (คัดลอกเป็น .env แล้วแก้ค่า)
POSTGRES_USER=cyberjob
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyberjob_member
POSTGRES_PORT=5432
PORT=3003

WEB_ORIGIN=http://localhost:3103

# สร้างค่าสุ่มด้วย: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback

# ตั้งเป็น true ครั้งแรกเพื่อเติมข้อมูลตัวอย่างลงฐานข้อมูล
SEED_ON_START=false

# cookie (ตั้งเมื่อ web กับ api อยู่คนละโดเมน)
COOKIE_SAMESITE=lax
COOKIE_SECURE=
